{
  "name": "calculator-mcp",
  "version": "1.0.0",
  "description": "A simple MCP server for adding two numbers",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/calculator-mcp/server.js",
    "dev": "tsc && node dist/src/calculator-mcp/server.js",
